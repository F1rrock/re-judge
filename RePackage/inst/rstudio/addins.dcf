Name: Available problems
Description: Show available problem names for the current contest
Binding: problems
Interactive: false

Name: Solved problems
Description: View solved problems
Binding: solved
Interactive: false

Name: Description of the problem
Description: Show the ejudge problem for the current file
Binding: problem
Interactive: false

Name: Previous solutions of this problem
Description: View previous solutions of the problem for the current file
Binding: submissions
Interactive: false

Name: Last report
Description: View last report of the problem for the current file
Binding: lastreport
Interactive: false

Name: Local testing
Description: Local testing via sample test
Binding: testification
Interactive: false

Name: Change credentials
Description: Change current login, password and contest
Binding: credentials
Interactive: true

Name: Switch contest
Description: Switch current contest
Binding: switchcontest
Interactive: true

Name: Submit the solution
Description: Submit current file as ejudge solution
Binding: autosubmit
Interactive: false

Name: Submit with pre-test
Description: Submit current file with local pre-test
Binding: submit
Interactive: false
